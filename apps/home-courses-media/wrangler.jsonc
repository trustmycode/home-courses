{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "home-courses-media",
  "workers_dev": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-07-08",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "COURSE_MEDIA",
      "bucket_name": "course-media"
    }
  ]
}
